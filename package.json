{
  "name": "tabby-better-configer",
  "version": "0.1.0",
  "description": "Structured config management for Tabby — per-module view, edit, import/export of config.yaml sections",
  "keywords": [
    "tabby-plugin"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "webpack --progress --color",
    "watch": "webpack --progress --color --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smokeLoad.js",
    "package": "node scripts/package.js",
    "package:install": "node scripts/package.js --install"
  },
  "author": "MSGhast",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MintSpearCandy/tabby-better-configer.git"
  },
  "homepage": "https://github.com/MintSpearCandy/tabby-better-configer#readme",
  "bugs": {
    "url": "https://github.com/MintSpearCandy/tabby-better-configer/issues"
  },
  "peerDependencies": {
    "@angular/core": "^15"
  },
  "devDependencies": {
    "@angular/common": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@electron/remote": "^2.0.12",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^18.19.0",
    "apply-loader": "^2.0.0",
    "css-loader": "^6.10.0",
    "js-yaml": "^4.1.0",
    "pug": "^2.0.3",
    "pug-loader": "^2.4.0",
    "rxjs": "^7.8.1",
    "sass": "^1.71.0",
    "sass-loader": "^13.3.3",
    "tabby-core": "1.0.231-nightly.0",
    "to-string-loader": "^1.2.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
